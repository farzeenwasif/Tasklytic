# Copy to .env and fill in. Never commit the real .env.

PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/tasklytic
# Frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173
# Where emailed links and Stripe redirects point (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# Auth
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d

# Cloudinary (profile photos)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Email for password reset. Leave empty in development: emails are printed in the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Premium plan (Stripe, $20/month). Leave empty to disable payments.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI features for Premium users
AI_API_KEY=
AI_MODEL=
# Max AI requests per user per 10 minutes
AI_RATE_LIMIT=40
# Accounts with free Premium access (comma-separated emails)
PREMIUM_EMAILS=
